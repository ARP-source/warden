# Warden credentials. Copy to .env and fill in. .env is gitignored.
#
# Anthropic: powers the Target, Attacker, Defender and Analysis agents.
# Without this, the system runs in simulated mode with rule-based test doubles.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Weights & Biases: Weave tracing for every model call and tool-call attempt.
# This is the key the Warden CODE needs. It is NOT the same as the wandb MCP
# server in Claude Code, which authenticates over OAuth and needs no key.
# Get one at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_ENTITY=
WARDEN_WEAVE_PROJECT=warden-permission-immune-system

# Supabase: hosted Postgres for the audit ledger, budget ledger and Target data.
# Project URL looks like https://<ref>.supabase.co
SUPABASE_URL=
# Service role key: required, because the ledger writes from a trusted backend.
# Never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: used by read-only dashboard views.
SUPABASE_ANON_KEY=

# Execution mode: auto | live | simulated
# auto = live when ANTHROPIC_API_KEY is present, simulated otherwise.
WARDEN_MODE=auto

# Storage backend: auto | supabase | sqlite
# auto = supabase when SUPABASE_URL and the service role key are present.
WARDEN_STORE=auto

# Hard spend ceiling for the whole run, in USD. Enforced before every model call.
WARDEN_BUDGET_CEILING_USD=8.00

# Shared secret for the POST /admin/* routes (reload, halt, clear-halt).
# The service is deployed publicly and /admin/halt is a kill switch, so these
# routes are DISABLED (503) when this is unset rather than left open.
WARDEN_ADMIN_TOKEN=
